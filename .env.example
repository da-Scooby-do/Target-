# Copy to .env.local for local development. Set the same values in Vercel.

# Resend (https://resend.com) API key. Without it, local dev prints emails to the terminal.
RESEND_API_KEY=

# Inbox for quote requests and contact messages.
# Until a domain is verified in Resend, this must be the Resend account's own email address.
INBOX_EMAIL=

# Only after the domain is verified in Resend:
# EMAIL_FROM="Target Facility Service <noreply@your-domain.nl>"
# SEND_CONFIRMATIONS=true

# Public URL of the site, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (login, My TFS, admin). Without these the site works but login is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
